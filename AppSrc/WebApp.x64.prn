37788>>>                // If from main, this is a probably a main-file lookup from a Zoom
37788>>>                WebSet pbRender of oDetailButton to False
37789>>>                Case Break
37790>>>
37790>>>            Case Else // must be nfUndefined
37790>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37790>>>                // If Row select does main-zoom we don't need this
37790>>>                WebSet pbRender of oDetailButton to False
37791>>>
37791>>>        Case End
