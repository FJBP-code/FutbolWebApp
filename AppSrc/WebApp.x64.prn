37907>>>    Procedure SetActionButtons
37910>>>        tWebNavigateData NavigateData
37910>>>        tWebNavigateData NavigateData
37910>>>        Boolean bHasRecord
37910>>>        Handle hoDD
37910>>>
37910>>>        Get Server to hoDD
37911>>>        Get GetNavigateData to NavigateData
37912>>>        Get HasRecord of hoDD to bHasRecord
37913>>>
37913>>>        // let's hide all buttons and then Show the ones we want
37913>>>        WebSet pbRender of oEditBtn to False
37914>>>        WebSet pbRender of oSaveBtn to False
37915>>>        WebSet pbRender of oCancelChangesBtn to False
37916>>>        WebSet pbRender of oDeleteBtn to False
37917>>>
37917>>>        If (NavigateData.bReadOnly) Begin
37919>>>            WebSet pbRender of oEditBtn to True
37920>>>        End
37920>>>>
37920>>>        Else Begin
37921>>>            WebSet pbRender of oSaveBtn to True
37922>>>            WebSet pbRender of oCancelChangesBtn to True
37923>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37924>>>        End
37924>>>>
37924>>>    End_Procedure
