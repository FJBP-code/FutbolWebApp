37893>>>        tWebNavigateData NavigateData
37893>>>        tWebNavigateData NavigateData
37893>>>        Boolean bHasRecord
37893>>>        Handle hoDD
37893>>>
37893>>>        Get Server to hoDD
37894>>>        Get GetNavigateData to NavigateData
37895>>>        Get HasRecord of hoDD to bHasRecord
37896>>>
37896>>>        // let's hide all buttons and then Show the ones we want
37896>>>        WebSet pbRender of oEditBtn to False
37897>>>        WebSet pbRender of oSaveBtn to False
37898>>>        WebSet pbRender of oCancelChangesBtn to False
37899>>>        WebSet pbRender of oDeleteBtn to False
37900>>>
37900>>>        If (NavigateData.bReadOnly) Begin
37902>>>            WebSet pbRender of oEditBtn to True
37903>>>        End
37903>>>>
37903>>>        Else Begin
37904>>>            WebSet pbRender of oSaveBtn to True
37905>>>            WebSet pbRender of oCancelChangesBtn to True
37906>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37907>>>        End
37907>>>>
37907>>>    End_Procedure
