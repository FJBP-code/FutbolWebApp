37577>>>    Procedure SetActionButtons
37580>>>        tWebNavigateData NavigateData
37580>>>        tWebNavigateData NavigateData
37580>>>        Boolean bHasRecord
37580>>>        Handle hoDD
37580>>>
37580>>>        Get Server to hoDD
37581>>>        Get GetNavigateData to NavigateData
37582>>>        Get HasRecord of hoDD to bHasRecord
37583>>>
37583>>>        // let's hide all buttons and then Show the ones we want
37583>>>        WebSet pbRender of oEditBtn to False
37584>>>        WebSet pbRender of oSaveBtn to False
37585>>>        WebSet pbRender of oCancelChangesBtn to False
37586>>>        WebSet pbRender of oDeleteBtn to False
37587>>>
37587>>>        If (NavigateData.bReadOnly) Begin
37589>>>            WebSet pbRender of oEditBtn to True
37590>>>        End
37590>>>>
37590>>>        Else Begin
37591>>>            WebSet pbRender of oSaveBtn to True
37592>>>            WebSet pbRender of oCancelChangesBtn to True
37593>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37594>>>        End
37594>>>>
37594>>>    End_Procedure
